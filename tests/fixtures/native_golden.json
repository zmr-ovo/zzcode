{
  "schema_version": 1,
  "cases": [
    {
      "id": "read_then_final",
      "prompt": "Inspect sample.txt",
      "files": {
        "sample.txt": "alpha\nbeta\n"
      },
      "outputs": [
        {
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_call",
                "call_id": "call_0",
                "name": "read_file",
                "arguments": {
                  "path": "sample.txt",
                  "start": 1,
                  "end": 2
                }
              }
            ]
          },
          "stop_reason": "tool_call"
        },
        "Read alpha and beta."
      ],
      "expected": {
        "answer": "Read alpha and beta.",
        "stop_reason": "final_answer_returned",
        "attempts": 2,
        "tool_steps": 1,
        "tools": [
          "read_file"
        ],
        "tool_contains": [
          "alpha"
        ],
        "files": {
          "sample.txt": "alpha\nbeta\n"
        }
      }
    },
    {
      "id": "native_patch_then_final",
      "prompt": "Replace beta with gamma in sample.txt",
      "files": {
        "sample.txt": "alpha\nbeta\n"
      },
      "outputs": [
        {
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_call",
                "call_id": "call_0",
                "name": "patch_file",
                "arguments": {
                  "path": "sample.txt",
                  "old_text": "beta",
                  "new_text": "gamma"
                }
              }
            ]
          },
          "stop_reason": "tool_call"
        },
        "Patched."
      ],
      "expected": {
        "answer": "Patched.",
        "stop_reason": "final_answer_returned",
        "attempts": 2,
        "tool_steps": 1,
        "tools": [
          "patch_file"
        ],
        "tool_contains": [
          "patched sample.txt"
        ],
        "files": {
          "sample.txt": "alpha\ngamma\n"
        }
      }
    },
    {
      "id": "malformed_then_recover",
      "prompt": "Inspect sample.txt",
      "files": {
        "sample.txt": "alpha\n"
      },
      "outputs": [
        "",
        {
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_call",
                "call_id": "call_1",
                "name": "read_file",
                "arguments": {
                  "path": "sample.txt"
                }
              }
            ]
          },
          "stop_reason": "tool_call"
        },
        "Recovered."
      ],
      "expected": {
        "answer": "Recovered.",
        "stop_reason": "final_answer_returned",
        "attempts": 3,
        "tool_steps": 1,
        "tools": [
          "read_file"
        ],
        "tool_contains": [
          "alpha"
        ],
        "files": {
          "sample.txt": "alpha\n"
        }
      }
    },
    {
