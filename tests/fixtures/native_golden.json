        {
          "message": {
            "role": "assistant",
            "content": [
              {
                "type": "tool_call",
                "call_id": "call_0",
                "name": "write_file",
                "arguments": {
                  "path": "sample.txt",
                  "content": "changed"
                }
              }
            ]
          },
          "stop_reason": "tool_call"
        },
        "Write denied."
