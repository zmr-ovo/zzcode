      "expected": {
        "answer": "Write denied.",
        "stop_reason": "final_answer_returned",
        "attempts": 2,
        "tool_steps": 1,
        "tools": [
          "write_file"
        ],
        "tool_contains": [
          "approval denied"
        ],
        "files": {
          "sample.txt": "alpha\n"
        }
      }
    },
