-    def tool_signature(self):
-        payload = []
-        for name in sorted(self.tools):
-            tool = self.tools[name]
-            payload.append(
-                {
-                    "name": name,
-                    "schema": tool["schema"],
-                    "risky": tool["risky"],
-                    "description": tool["description"],
-                }
-            )
-        return hashlib.sha256(json.dumps(payload, sort_keys=True).encode("utf-8")).hexdigest()
