-def middle(text, limit):
-    text = str(text).replace("\n", " ")
-    if len(text) <= limit:
-        return text
-    if limit <= 3:
-        return text[:limit]
-    left = (limit - 3) // 2
-    right = limit - 3 - left
-    return text[:left] + "..." + text[-right:]
